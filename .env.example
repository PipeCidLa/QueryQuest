# =============================================================================
# .env.example
# Plantilla de variables de entorno. rellenar los
# valores reales. NUNCA subas .env al repositorio.
#
# Uso:
#   cp .env.example .env
# =============================================================================

# --- Servidor -----------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Base de datos de la aplicación (queryquest_app) --------------------------
# Lectura/escritura: usuarios, misiones, progreso, intentos, logros.
DB_APP_HOST=127.0.0.1
DB_APP_PORT=3306
DB_APP_USER=qq_app
DB_APP_PASS=cambiar_esto
DB_APP_NAME=queryquest_app

# --- Base de datos sandbox (queryquest_sandbox) -------------------------------
# SOLO SELECT. El usuario de MySQL debe tener únicamente GRANT SELECT.
DB_SANDBOX_HOST=127.0.0.1
DB_SANDBOX_PORT=3306
DB_SANDBOX_USER=qq_sandbox
DB_SANDBOX_PASS=cambiar_esto
DB_SANDBOX_NAME=queryquest_sandbox

# --- Sesión -------------------------------------------------------------------
# Cadena larga y aleatoria. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cambiar_esto_por_una_cadena_larga_y_aleatoria

# --- Ejecución SQL ------------------------------------------------------------
# Tiempo máximo por consulta del alumno (ms) y peticiones por minuto al endpoint
# POST /api/misiones/:id/ejecutar.
SQL_TIMEOUT_MS=2500
RATE_LIMIT_EJECUTAR=20