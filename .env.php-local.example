; Copiar los valores a .env.php-local solo si ya existen las cuentas MySQL.
; setup_local.php genera el archivo real con claves diferentes en cada computador.
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_APP_NAME=queryquest_app
DB_APP_USER=qq_app
DB_APP_PASS="clave_local_aplicacion"
DB_SANDBOX_NAME=queryquest_sandbox
DB_SANDBOX_USER=qq_sandbox
DB_SANDBOX_PASS="clave_local_practica"
